# NAMORA E-COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your production credentials.
# NEVER commit .env to public version control or expose secrets in client-side code!

# ==============================================================================
# 1. SUPABASE (Database, Auth & Edge Functions)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose

# ==============================================================================
# 2. RAZORPAY PAYMENT GATEWAY (Test / Live Mode)
# ==============================================================================
# Public Key ID (Used by Frontend Checkout)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Secret Key (Used ONLY by Backend / Edge Functions for HMAC verification)
RAZORPAY_KEY_SECRET=your_razorpay_secret_do_not_expose

# Webhook Secret (Used to verify Razorpay webhook signatures)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================================================================
# 3. STORE & BUSINESS SETTINGS
# ==============================================================================
STORE_NAME=NAMORA
FRAME_BASE_PRICE=499
DEPOSIT_PER_FRAME=49
COD_BALANCE=450
GIFT_PACKAGING_PRICE=69
WHATSAPP_HELPLINE=919305654028
UPI_ID=namoraworld@upi
PORT=3300
