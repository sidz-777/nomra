# ==============================================================================
# NAMORA — Environment Variables Template
# ==============================================================================
# NOTE: Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secret keys to source control!

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE / PUBLIC CONFIGURATION (Prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Publishable Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Public Key ID (Safe for browser checkout SDK)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Public Application & API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Official Concierge Support Channels
NEXT_PUBLIC_WHATSAPP_PHONE=919305654028
NEXT_PUBLIC_SUPPORT_EMAIL=namora.frames@gmail.com

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY PROHIBITED IN BROWSER BUNDLES)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for secure server operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Razorpay Secret Key (Used for server-side order creation & HMAC verification)
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# Razorpay Webhook Secret (Used for verifying webhook signature payload)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Internal Admin API Secret (Used for server-to-server admin automation)
ADMIN_API_SECRET=your-admin-api-secret
